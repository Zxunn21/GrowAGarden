local function FindPlants(Query)
    Query = string.lower(Query)

    local Results = {}
    local Children = Plants:GetChildren()

    for Index, Plant in ipairs(Children) do
        local Name = string.lower(Plant.Name)

        if string.find(Name, Query, 1, true) then
            table.insert(Results, {
                Instance = Plant,
                Index = Index
            })
        end
    end

    return Results
end

Search:GetPropertyChangedSignal("Text"):Connect(function()
    local Query = Search.Text

    if Query == "" then
        Status.Text = "Masukkan nama tanaman"
        return
    end

    local Results = FindPlants(Query)

    if #Results == 0 then
        Status.Text = "Tidak ditemukan"
    elseif #Results == 1 then
        Status.Text = Results[1].Instance.Name .. " [" .. Results[1].Index .. "]"
    else
        Status.Text = tostring(#Results) .. " tanaman ditemukan"
    end
end)

local Moving = false

Move.MouseButton1Click:Connect(function()
    if Moving then
        return
    end

    local Query = Search.Text

    if Query == "" then
        Status.Text = "Masukkan nama tanaman!"
        return
    end

    local Character = Player.Character

    if not Character then
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        Status.Text = "HumanoidRootPart tidak ditemukan"
        return
    end

    local Results = FindPlants(Query)

    if #Results == 0 then
        Status.Text = "Tanaman tidak ditemukan"
        return
    end

    Moving = true
    Move.Text = "MOVING..."

    local BaseCFrame = Root.CFrame
    local Moved = 0

    for Number, Data in ipairs(Results) do
        local Target = Data.Instance

        if Target and Target.Parent then
            local Trowel = GetTrowel()

            if not Trowel then
                Status.Text = "Trowel tidak ditemukan!"
                break
            end

            Status.Text = "Moving " .. Number .. "/" .. #Results

            Event:InvokeServer(
                "Pickup",
                Trowel,
                Target
            )

            task.wait(0.15)

            Trowel = GetTrowel()

            if Trowel then
                local Column = (Number - 1) % 5
                local Row = math.floor((Number - 1) / 5)

                local Destination = BaseCFrame * CFrame.new(
                    (Column - 2) * 3,
                    0,
                    -(Row + 1) * 3
                )

                Event:InvokeServer(
                    "Place",
                    Trowel,
                    Target,
                    Destination
                )

                Moved += 1

                task.wait(0.15)
            end
        end
    end

    Status.Text = "Selesai | " .. Moved .. "/" .. #Results .. " dipindahkan"
    Move.Text = "MOVE ALL"
    Moving = false
end)

