local function GetTrowel()
    for _, Object in ipairs(Player.Backpack:GetChildren()) do
        if Object:IsA("Tool") and string.find(string.lower(Object.Name), "trowel", 1, true) then
            return Object
        end
    end

    local Character = Player.Character

    if Character then
        for _, Object in ipairs(Character:GetChildren()) do
            if Object:IsA("Tool") and string.find(string.lower(Object.Name), "trowel", 1, true) then
                return Object
            end
        end
    end

    return nil
end

local function DisablePlantCollision(Plant)
    if not Plant then
        return
    end

    if Plant:IsA("BasePart") then
        Plant.CanCollide = false
        Plant.CanTouch = false
        Plant.CanQuery = false
    end

    for _, Object in ipairs(Plant:GetDescendants()) do
        if Object:IsA("BasePart") then
            Object.CanCollide = false
            Object.CanTouch = false
            Object.CanQuery = false
        end
    end
end

