local function FindPlants(Query)
    Query = string.lower(Query)

    local Results = {}
    local Children = Plants:GetChildren()

    for Index, Plant in ipairs(Children) do
        local Name = string.lower(Plant.Name)

        if string.find(Name, Query, 1, true) then
            table.insert(Results, {
                Instance = Plant,
                Index = Index
            })
        end
    end

    return Results
end

Search:GetPropertyChangedSignal("Text"):Connect(function()
    local Query = Search.Text

    if Query == "" then
        Status.Text = "Masukkan nama tanaman"
        return
    end

    local Results = FindPlants(Query)

    if #Results == 0 then
        Status.Text = "Tidak ditemukan"
    elseif #Results == 1 then
        Status.Text = Results[1].Instance.Name .. " [" .. Results[1].Index .. "]"
    else
        Status.Text = tostring(#Results) .. " tanaman ditemukan"
    end
end)

local WaterLoopEnabled = false
local WaterLoopToken = 0
local WaterPosition = nil
local WateringCanMissing = false
local WaitingForWaterResult = false

local function GetWaterDelay()
    local Delay = tonumber(WaterDelay.Text)
    if not Delay or Delay <= 0 then
        Delay = 1
        WaterDelay.Text = "1"
    end
    return Delay
end

local function FireWater()
    if not WaterPosition then
        return false
    end

    WaitingForWaterResult = true
    WateringCanMissing = false
    WaterEvent:FireServer(Vector3.new(WaterPosition.X, 0.1, WaterPosition.Z))
    return true
end

local function StartWaterLoop()
    if WaterLoopEnabled then
        return true
    end

    local Character = Player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        WaterStatus.Text = "No player"
        return false
    end

    WaterLoopEnabled = true
    WaterLoopToken += 1
    local Token = WaterLoopToken
    local Position = Root.Position
    WaterPosition = Vector3.new(Position.X, 0.1, Position.Z)
    WateringCanMissing = false
    WaitingForWaterResult = false
    WaterLoop.Text = "ON"
    WaterLoop.BackgroundColor3 = Color3.fromRGB(70, 170, 90)
    WaterStatus.Text = "ON"

    task.spawn(function()
        while WaterLoopEnabled and WaterLoopToken == Token and ScreenGui.Parent do
            if not FireWater() then
                WaterStatus.Text = "No player"
                task.wait(GetWaterDelay())
            else
                task.wait(0.35)
                WaitingForWaterResult = false

                if WateringCanMissing then
                    WaterStatus.Text = "WAIT 5s"
                    task.wait(4.65)
                else
                    local Delay = GetWaterDelay()
                    WaterStatus.Text = "ON"
                    task.wait(math.max(Delay - 0.35, 0))
                end
            end
        end
    end)

    return true
end

local function StopWaterLoop()
    WaterLoopEnabled = false
    WaterLoopToken += 1
    WaterPosition = nil
    WateringCanMissing = false
    WaitingForWaterResult = false
    WaterLoop.Text = "LOOP"
    WaterLoop.BackgroundColor3 = Color3.fromRGB(70, 120, 180)
    WaterStatus.Text = "OFF"
end

local function ShowNotification(Message)
    local Fired = false

    if type(firesignal) == "function" then
        Fired = pcall(function()
            firesignal(NotificationEvent.OnClientEvent, Message)
        end)
    end

    if not Fired then
        pcall(function()
            NotificationEvent:FireServer(Message)
        end)
    end
end

local Moving = false

Move.MouseButton1Click:Connect(function()
    if Moving then
        return
    end

    local Query = Search.Text

    if Query == "" then
        Status.Text = "Masukkan nama tanaman!"
        return
    end

    local Character = Player.Character

    if not Character then
        Status.Text = "Character tidak ditemukan"
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        Status.Text = "HumanoidRootPart tidak ditemukan"
        return
    end

    local Results = FindPlants(Query)

    if #Results == 0 then
        Status.Text = "Tanaman tidak ditemukan"
        return
    end

    StartWaterLoop()

    Moving = true
    Move.Text = "MOVING..."

    local BasePosition = Root.Position

    local Destination = CFrame.new(
        BasePosition.X,
        BasePosition.Y,
        BasePosition.Z
    )

    local Moved = 0

    for Number, Data in ipairs(Results) do
        local Target = Data.Instance

        if Target and Target.Parent then
            DisablePlantCollision(Target)

            local Trowel = GetTrowel()

            if not Trowel then
                Status.Text = "Trowel tidak ditemukan!"
                break
            end

            Status.Text = "Moving " .. Number .. "/" .. #Results

            local PickupSuccess = pcall(function()
                Event:InvokeServer(
                    "Pickup",
                    Trowel,
                    Target
                )
            end)

            if PickupSuccess then
                task.wait(0.03)
                DisablePlantCollision(Target)

                local PlaceSuccess = pcall(function()
                    Event:InvokeServer(
                        "Place",
                        Trowel,
                        Target,
                        Destination
                    )
                end)

                if PlaceSuccess then
                    Moved += 1
                end

                task.wait(0.03)
                DisablePlantCollision(Target)
            end
        end
    end

    Status.Text = "Selesai | " .. Moved .. "/" .. #Results .. " dipindahkan"
    Move.Text = "MOVE"
    Moving = false
end)

