local function GetSprinklers()
    local Results = {}
    local Seen = {}

    local function Add(Object)
        if Object and not Seen[Object] and string.find(string.lower(Object.Name), "sprinkler", 1, true) then
            Seen[Object] = true
            table.insert(Results, Object)
        end
    end

    if type(getnilinstances) == "function" then
        local Success, NilObjects = pcall(getnilinstances)
        if Success and NilObjects then
            for _, Object in ipairs(NilObjects) do
                Add(Object)
            end
        end
    end

    for _, Object in ipairs(game:GetDescendants()) do
        Add(Object)
    end

    return Results
end

