local function RefreshSeedButtons()
    local Count = 0

    for _, Name in ipairs(SeedNames) do
        local Button = SeedButtons[Name]
        if SelectedSeeds[Name] then
            Count += 1
            Button.Text = "  ☑  " .. Name
            Button.BackgroundColor3 = Color3.fromRGB(55, 95, 65)
        else
            Button.Text = "  ☐  " .. Name
            Button.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        end
    end

    SeedStatus.Text = tostring(Count) .. " dipilih"
    SeedAll.Text = Count == #SeedNames and "BATAL SEMUA" or "PILIH SEMUA"
end

for _, Name in ipairs(SeedNames) do
    SeedButtons[Name].MouseButton1Click:Connect(function()
        SelectedSeeds[Name] = not SelectedSeeds[Name]
        RefreshSeedButtons()
    end)
end

SeedAll.MouseButton1Click:Connect(function()
    local AllSelected = true

    for _, Name in ipairs(SeedNames) do
        if not SelectedSeeds[Name] then
            AllSelected = false
            break
        end
    end

    for _, Name in ipairs(SeedNames) do
        SelectedSeeds[Name] = not AllSelected
    end

    RefreshSeedButtons()
end)

local SeedDropdownOpen = false

local function UpdateSeedDropdownPosition()
    local ButtonPosition = SeedMenuButton.AbsolutePosition
    local ButtonSize = SeedMenuButton.AbsoluteSize
    local Viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
    local X = ButtonPosition.X
    local Y = ButtonPosition.Y + ButtonSize.Y + 4

    if X + SeedDropdownWidth > Viewport.X - 6 then
        X = math.max(6, Viewport.X - SeedDropdownWidth - 6)
    end

    if Y + 172 > Viewport.Y - 6 then
        Y = math.max(6, ButtonPosition.Y - 176)
    end

