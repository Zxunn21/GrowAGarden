local HarvestLoopEnabled = false
local HarvestLoopToken = 0

local function HarvestOnce()
    local FruitContainers = 0
    local Targets = {}

    for _, Plant in ipairs(Plants:GetChildren()) do
        local Fruits = Plant:FindFirstChild("Fruits")

        if Fruits then
            FruitContainers += 1

            for _, Object in ipairs(Fruits:GetDescendants()) do
                if Object:IsA("Model") then
                    Targets[#Targets + 1] = Object
                end
            end
        end
    end

    if #Targets == 0 then
        HarvestStatus.Text = tostring(FruitContainers) .. " Fruits | 0 buah"
        return 0
    end

    local Sent = 0

    for _, Target in ipairs(Targets) do
        if not HarvestLoopEnabled then
            break
        end

        local Success = pcall(function()
            CollectEvent:FireServer({Target})
        end)

        if Success then
            Sent += 1
        end

        task.wait(0.01)
    end

    HarvestStatus.Text = tostring(#Targets) .. " buah | " .. tostring(Sent) .. " sent"
    return Sent
end

